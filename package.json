{
  "name": "ottoman-tower-defense",
  "description": "Kingdom Guardians: an Ottoman-inspired tower defense game built with Phaser 3, TypeScript and Vite.",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --config vite/config.dev.mjs",
    "build": "tsc --noEmit && vite build --config vite/config.prod.mjs",
    "preview": "vite preview --config vite/config.prod.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets": "node scripts/generate-assets.mjs",
    "assets:force": "node scripts/generate-assets.mjs --force",
    "balance": "vitest run tests/integration/balance.sim.test.ts --reporter=verbose"
  },
  "devDependencies": {
    "terser": "^5.51.4",
    "typescript": "~5.7.3",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "phaser": "3.90.0"
  }
}
